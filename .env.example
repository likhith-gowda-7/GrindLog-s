# Example environment variables for CI/CD contexts
# These are ONLY used in CI pipelines, not for local development.
# For local usage, GrindLog uses encrypted storage (~/.grindlog/).

# ──────────────────────────────────
# LeetCode (NOT recommended for CI)
# ──────────────────────────────────
# Session sync should be done LOCALLY using `grindlog auth`
# LEETCODE_SESSION=your_session_cookie
# LEETCODE_CSRF_TOKEN=your_csrf_token
# LEETCODE_USERNAME=your_username

# ──────────────────────────────────
# AI Provider (optional)
# ──────────────────────────────────
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# ──────────────────────────────────
# Node.js
# ──────────────────────────────────
NODE_ENV=development
